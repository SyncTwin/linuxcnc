$ iec2comp --help
usage: iec2comp [-h] --thread-period NS [--thread THREAD] [--axis NAME=N]
                [--name NAME] [-o OUTPUT]
                program

IEC 61131-3 program (ST/SFC) -> HAL component (.comp for halcompile) via the
MATIEC compiler iec2c

positional arguments:
  program              program.st (one PROGRAM; FUNCTION_BLOCKs may precede
                       it)

options:
  -h, --help           show this help message and exit
  --thread-period NS   period of the HAL thread in ns: TASK INTERVAL and the
                       tick of timers
  --thread THREAD      thread for addf (default servo-thread)
  --axis NAME=N        AXIS_REF variable NAME of VAR_EXTERNAL is mc-axis.N
                       (repeatable)
  --name NAME          component name (default iec_<program>)
  -o, --output OUTPUT  directory for <name>.comp, <name>.hal and the headers
exit=0

# first attempt: blink.st with located and plain vars in ONE VAR block -> iec2c: "invalid located variable declaration" (input error, IEC grammar keeps located_var_declarations separate); fixed input below
$ MATIEC=/home/user/matiec (9c75953) iec2comp blink.st --thread-period 1000000 -o OUT
/tmp/claude-0/i2c/iec_blink.comp: halcompile --install /tmp/claude-0/i2c/iec_blink.comp
exit=0
accessor.h
globals_instances_py.h
globals_proto_c.h
globals_ticktime_py.h
iec_blink.comp
iec_blink.hal
iec_std_FB.h
iec_std_FB_impl.h
iec_std_FB_no_ENENO.h
iec_std_FB_no_ENENO_impl.h
iec_std_functions.h
iec_std_lib.h
iec_types.h
iec_types_all.h
iec_types_list.h
pous_decl_py.h
pous_flatcount_c.h
pous_flatcount_py.h
pous_recurse_c.h
undef_macros.h

--- iec_blink.hal
loadrt iec_blink
addf iec-blink.0 servo-thread
--- pins in .comp
pin in bit permit "0 = program stopped, outputs at their -safe values";
pin in bit enable "1 = run the program (AND permit)";
pin out bit qx_0_0 "%QX0.0 lamp";
pin in bit qx_0_0_safe "%QX0.0 while enable = 0: the safe value of the output";
function _;

