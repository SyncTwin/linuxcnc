loadrt threads name1=t period1=1000000
loadrt mc_axis names=ax
addf ax t

# an ideal drive: the feedback follows the command, the drive is
# operation-enabled while the axis enables it
net cmd ax.pos-cmd => ax.pos-fb
net en  ax.enable-out => ax.stat-op-enabled

setp ax.min-limit -1
setp ax.max-limit 110
setp ax.maxv 50
setp ax.maxa 200
setp ax.ferror-max 1
setp ax.velocity 50
setp ax.acceleration 200

start
loadusr -w ./mctest.py
