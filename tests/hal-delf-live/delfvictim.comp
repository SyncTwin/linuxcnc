component delfvictim "Test component for tests/hal-delf-live: stays inside its function for a while when hold is set";

pin io bit hold "set to hold the thread inside the function once; cleared by the function";
pin out bit inside;
pin out u32 count "passes of the function";

function _;
license "GPL";
author "SyncTwin";
;;
count++;
/* hold the thread for 500 periods: shorter than the 1000 periods delf
   waits at most, long enough that a delf that does not wait returns
   while the thread is still inside */
if (hold) {
    long long t0 = rtapi_get_time();
    hold = 0;
    inside = 1;
    while (rtapi_get_time() - t0 < 500LL * period) { }
    inside = 0;
}
