# Status -> NATS (Sparkplug B). With libnats the Sparkplug schema is the one
# shared with hal2spb (configure --with-sparkplug-proto=FILE), compiled here by
# protoc-c; without it tasknats.cc builds its "off" stub.
ifdef HAVE_LIBNATS
SPB_GEN := objects/spb
$(SPB_GEN)/sparkplug_b_payload.pb-c.c $(SPB_GEN)/sparkplug_b_payload.pb-c.h: $(SPARKPLUG_PROTO)
	$(ECHO) Generating Sparkplug B protobuf-c from $(notdir $<)
	@mkdir -p $(SPB_GEN)
	$(Q)cp $< $(SPB_GEN)/sparkplug_b_payload.proto
	$(Q)cd $(SPB_GEN) && $(PROTOC_C) --c_out=. sparkplug_b_payload.proto
MILLTASKSRCS += $(SPB_GEN)/sparkplug_b_payload.pb-c.c
objects/emc/task/tasknats.o: $(SPB_GEN)/sparkplug_b_payload.pb-c.h
objects/emc/task/tasknats.o: EXTRAFLAGS += -I$(SPB_GEN) $(LIBNATS_CFLAGS) $(PROTOBUFC_CFLAGS)
objects/$(SPB_GEN)/sparkplug_b_payload.pb-c.o: EXTRAFLAGS += $(PROTOBUFC_CFLAGS)
MILLTASK_NATS_LIBS := $(LIBNATS_LIBS) $(PROTOBUFC_LIBS)
endif

USERSRCS += $(MILLTASKSRCS)

#LDFLAGS +=

../bin/milltask: $(call TOOBJS, $(MILLTASKSRCS)) ../lib/librs274.so.0 ../lib/liblinuxcnc.a \
                 ../lib/libnml.so.0 ../lib/liblinuxcncini.so.1 ../lib/libposemath.so.0 \
                 ../lib/liblinuxcnchal.so.0 ../lib/libpyplugin.so.0 \
                 ../lib/libtooldata.so.0


	$(ECHO) Linking $(notdir $@)
	$(CXX) -o $@ $^ $(LDFLAGS) $(PYTHON_EXTRA_LDFLAGS) $(BOOST_PYTHON_LIB) $(PYTHON_LIBS) $(PYTHON_EXTRA_LIBS) -lfmt $(MILLTASK_NATS_LIBS)
TARGETS += ../bin/milltask
