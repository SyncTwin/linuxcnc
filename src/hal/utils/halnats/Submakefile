# halnats: one Sparkplug B node over NATS for a HAL host (halnats.hh).
# The library is linked by milltask (status devices, emc/task/tasknats.cc) and by
# the halnats binary (VMs with HAL and no LinuxCNC). The Sparkplug schema is the
# one shared with hal2spb (configure --with-sparkplug-proto=FILE), compiled here
# by protoc-c. Without libnats nothing is built and milltask has its "off" stub.
ifdef HAVE_LIBNATS
SPB_GEN := objects/spb
# lcec_image.h by its configured path (a computed include, no -I into the lcec tree)
HALNATS_CFLAGS := -I$(SPB_GEN) -Ihal/utils/halnats $(LIBNATS_CFLAGS) $(PROTOBUFC_CFLAGS) '-DLCEC_IMAGE_H="$(LCEC_IMAGE_H)"'
HALNATS_LIBS := $(LIBNATS_LIBS) $(PROTOBUFC_LIBS)

$(SPB_GEN)/sparkplug_b_payload.pb-c.c $(SPB_GEN)/sparkplug_b_payload.pb-c.h: $(SPARKPLUG_PROTO)
	$(ECHO) Generating Sparkplug B protobuf-c from $(notdir $<)
	@mkdir -p $(SPB_GEN)
	$(Q)cp $< $(SPB_GEN)/sparkplug_b_payload.proto
	$(Q)cd $(SPB_GEN) && $(PROTOC_C) --c_out=. sparkplug_b_payload.proto

HALNATSLIBSRCS := hal/utils/halnats/halnats.cc $(SPB_GEN)/sparkplug_b_payload.pb-c.c
USERSRCS += $(HALNATSLIBSRCS)
objects/hal/utils/halnats/halnats.o: $(SPB_GEN)/sparkplug_b_payload.pb-c.h $(LCEC_IMAGE_H)
$(call TOOBJSDEPS, $(HALNATSLIBSRCS)): EXTRAFLAGS += $(HALNATS_CFLAGS)

../lib/libhalnats.a: $(call TOOBJS, $(HALNATSLIBSRCS))
	$(ECHO) Linking $(notdir $@)
	@mkdir -p ../lib
	@rm -f $@
	@$(AR) $(ARFLAGS) $@ $^
TARGETS += ../lib/libhalnats.a

HALNATSSRCS := hal/utils/halnats/halnats_main.cc
USERSRCS += $(HALNATSSRCS)
$(call TOOBJSDEPS, $(HALNATSSRCS)): EXTRAFLAGS += $(HALNATS_CFLAGS)
objects/hal/utils/halnats/halnats_main.o: $(SPB_GEN)/sparkplug_b_payload.pb-c.h

../bin/halnats: $(call TOOBJS, $(HALNATSSRCS)) ../lib/libhalnats.a ../lib/liblinuxcncini.so.1 ../lib/liblinuxcnchal.so.0
	$(ECHO) Linking $(notdir $@)
	$(Q)$(CXX) -o $@ $^ $(LDFLAGS) $(HALNATS_LIBS)
TARGETS += ../bin/halnats
endif
