component trigwin "Кольцевой буфер отсчётов: выдаёт окно ВОКРУГ события (до + после)";
author "SyncTwin (aicnc), задача H11";
license "GPL";

description """
ЗАЧЕМ ЭТОТ КОМПОНЕНТ ВООБЩЕ НУЖЕН (штатные средства этого не умеют).\n
\n
`sampler`(9) льёт поток НЕПРЕРЫВНО, и когда FIFO переполняется, теряется\n
НОВОЕ: в `sampler.c` при `hal_stream_write() < 0` отсчёт просто отбрасывается\n
и растёт `overruns` — то есть кольцом «последних N отсчётов» sampler НЕ\n
является (в man'е написано «new data will begin overwriting old data», но код\n
делает обратное). Значит «две секунды ДО аварии» из sampler'а не достаются:\n
их либо уже вычитал userspace-читатель (и тогда они у него, а не в HAL), либо\n
их не записали вовсе.\n
\n
`sampler.N.enable` даёт ровно половину задачи: включил по событию — получил\n
окно ПОСЛЕ. Предыстории у этого пути нет по построению.\n
\n
Предысторию умеет `halscope`: его RT-часть `scope_rt` держит буфер с\n
`pre_trig`/`post_trig` и сама ловит уровень триггера. Но конфигурирует этот\n
буфер и вычитывает его ТОЛЬКО GUI `halscope` (GTK, нужен экран и человек за\n
ним, выгрузка — через диалог сохранения). Ни CLI, ни headless-режима у него\n
нет, поэтому «авария случилась ночью — окно само легло в файл» через него не\n
делается.\n
\n
`trigwin` закрывает именно эту дыру: RT-кольцо на каждом такте + вход\n
триггера + ВЫДАЧА окна обратно в HAL — по одному отсчёту за такт. Дальше\n
окно уезжает наружу ШТАТНОЙ дорогой (`sampler` + `halsampler`), потому что\n
второй транспорт нам не нужен.\n
\n
Схема применения (отдельный канал sampler'а, чтобы не мешать телеметрии):\n
\n
loadrt trigwin\n
loadrt sampler depth=8000 cfg=fffff\n
addf trigwin.0.capture servo-thread\n
addf sampler.1 servo-thread        # ⚠ ПОСЛЕ trigwin: гейт и данные одного такта\n
setp trigwin.0.pre 2000            # 2 с до события при такте 1 мс\n
setp trigwin.0.post 1000           # 1 с после\n
net x-err  pid.x.error       => trigwin.0.src-0\n
net x-tq   x-drive.act-torque=> trigwin.0.src-1\n
net alarm  x-drive.fault     => trigwin.0.trigger\n
net w-t    trigwin.0.win-t   => sampler.1.pin.0\n
net w-0    trigwin.0.win-0   => sampler.1.pin.1\n
net w-1    trigwin.0.win-1   => sampler.1.pin.2\n
net w-gate trigwin.0.win-valid => sampler.1.enable\n
\n
и снаружи один раз: `halsampler -c 1 > /var/log/synctwin/incident.txt`.\n
Пока события нет, `win-valid` = FALSE и в FIFO не попадает НИЧЕГО — канал\n
молчит, диск не растёт.\n
\n
ЧТО КОМПОНЕНТ НЕ ДЕЛАЕТ (осознанно, это RT-код в такте 1 мс):\n
* не сравнивает уровни и не ищет фронт величины — триггер это bit-вход,\n
  условие собирается штатными `comp`/`and2`/`edge` снаружи. Логика условия\n
  меняется от стенда к стенду, кольцо — нет;\n
* во время ВЫДАЧИ окна кольцо заморожено: живые отсчёты этих\n
  (pre+post+1) тактов не сохраняются. Выдача длится ровно столько же, сколько\n
  само окно (по отсчёту за такт), и это плата за отсутствие второго\n
  транспорта;\n
* глубина кольца ФИКСИРОВАНА (4096 отсчётов × 4 канала). Это ~4,1 с при такте\n
  1 мс и 128 КБ на экземпляр из общих 2 МБ HAL-shmem (`HAL_SIZE` в\n
  `hal_priv.h`) — поэтому `count=` больше двух-трёх экземпляров брать нельзя.\n
""";

// ── вход ────────────────────────────────────────────────────────────────────
// Четыре канала — столько влезает в кольцо при разумном расходе HAL-shmem.
// Неподключённые входы пишутся нулями и просто занимают столбец.
pin in float src-#[4] "величины, за которыми следим (столбцы окна)";
pin in bit trigger    "событие; окно набирается по ФРОНТУ 0→1";
pin in bit enable = true "FALSE — новых событий не ждём (уже начатая запись всё равно доводится до конца)";

// ── выход ───────────────────────────────────────────────────────────────────
pin out float win-#[4] "отсчёт окна: те же каналы, что и src-N";
pin out float win-t    "время отсчёта относительно события, мс (до события — минус)";
pin out bit win-valid  "TRUE, пока идёт выдача окна; этим гейтят sampler.N.enable";
pin out bit armed      "TRUE — кольцо копит и ждёт события";
pin out bit done       "импульс на ОДИН такт после того, как окно выдано целиком";

// ── настройка ───────────────────────────────────────────────────────────────
param rw s32 pre = 2000  "сколько отсчётов ДО события отдавать";
param rw s32 post = 1000 "сколько отсчётов ПОСЛЕ события отдавать";
param r  s32 pre_actual  "сколько отсчётов ДО реально ушло в последнее окно";
param r  s32 fill        "сколько отсчётов накоплено в кольце сейчас";
param r  u32 windows     "сколько окон выдано с загрузки";

variable double buf[16384];   // 4096 отсчётов × 4 канала, см. TW_DEPTH/TW_CH
variable long head = 0;       // сколько отсчётов записано всего (монотонно)
variable long fillv = 0;      // накоплено, ≤ TW_DEPTH (зеркало param fill)
variable long event = 0;      // head-индекс отсчёта, на котором сработал триггер
variable long emit_at = 0;    // при каком head набран «после» и можно выдавать
variable long win_start = 0;  // head-индекс первого отсчёта окна
variable long win_len = 0;
variable long emit_i = 0;
variable long post_used = 0;  // «после», зафиксированное в момент события
variable int state = 0;
variable bool trig_old = 0;
variable bool pending_done = 0;

function capture "Кольцо + отбор окна. Ставить ПЕРЕД sampler'ом в том же потоке.";

;;

#define TW_DEPTH 4096          /* степень двойки: индекс берём маской, без деления */
#define TW_CH    4
#define TW_ARM   0             /* копим кольцо, ждём событие */
#define TW_POST  1             /* событие было, добираем «после» */
#define TW_EMIT  2             /* отдаём окно по отсчёту за такт */

FUNCTION(capture) {
    long slot, idx, avail, pre_want;
    int i;
    int rising;

    /* Импульс `done` живёт ровно один такт: подняли в прошлом вызове —
       гасим в этом. Иначе «окно готово» залипло бы навсегда. */
    done_set(pending_done);
    pending_done = 0;

    /* ── ВЫДАЧА ────────────────────────────────────────────────────────────
       Кольцо здесь заморожено: писать в него живые отсчёты нельзя, иначе
       голова догонит и затрёт хвост, который мы ещё не отдали. Начатое окно
       доигрывается даже при enable=FALSE — оборванная запись аварии хуже
       отсутствующей: по ней делают ложные выводы. */
    if (state == TW_EMIT) {
        idx = win_start + emit_i;
        slot = (idx & (TW_DEPTH - 1)) * TW_CH;
        for (i = 0; i < TW_CH; i++) {
            win_set(i, buf[slot + i]);
        }
        /* period — период потока в нс; отсчёты идут ровно по такту. */
        win_t_set((double)(idx - event) * (double)period * 1e-6);
        win_valid_set(1);
        emit_i++;
        if (emit_i >= win_len) {
            /* Последняя строка окна отдана ИМЕННО В ЭТОМ такте — win_valid
               обязан остаться TRUE, иначе sampler (он стоит после нас)
               пропустит её. Гасим на следующем вызове. */
            state = TW_ARM;
            fillv = 0;          /* «до» считаем заново — от момента перевзвода */
            fill_set(0);           /* param обязан показать то же, а не прошлое окно */
            pending_done = 1;
            windows_set(windows + 1);
        }
        return;
    }

    win_valid_set(0);

    /* enable гасит только ОЖИДАНИЕ. Если событие уже случилось и мы добираем
       «после» — сбор продолжается вопреки enable: обрезанная запись аварии
       хуже отсутствующей, по ней делают ложные выводы. */
    if (state == TW_ARM && !enable) {
        armed_set(0);
        trig_old = trigger;
        return;
    }

    /* ── ЗАПИСЬ В КОЛЬЦО ───────────────────────────────────────────────────
       Это и есть «до события»: пока ничего не случилось, данные крутятся по
       кругу и уезжают в никуда. */
    slot = (head & (TW_DEPTH - 1)) * TW_CH;
    for (i = 0; i < TW_CH; i++) {
        buf[slot + i] = src(i);
    }
    head++;
    if (fillv < TW_DEPTH) fillv++;
    fill_set((int)fillv);

    rising = (trigger && !trig_old);
    trig_old = trigger;

    if (state == TW_ARM) {
        armed_set(1);
        if (rising) {
            /* Отсчёт события — тот, что записан ЭТИМ тактом (head-1). */
            event = head - 1;
            post_used = post;
            if (post_used < 0) post_used = 0;
            /* Больше кольца «после» не унести: хвост затёр бы предысторию. */
            if (post_used > TW_DEPTH - 1) post_used = TW_DEPTH - 1;
            emit_at = event + 1 + post_used;
            state = TW_POST;
            armed_set(0);
        }
    }

    if (state == TW_POST && head >= emit_at) {
        /* «После» набрано — считаем, сколько предыстории реально есть.
           Отдать больше, чем накоплено, нельзя; молча дорисовывать нули —
           тем более (по такой записи ищут причину аварии). */
        pre_want = pre;
        if (pre_want < 0) pre_want = 0;
        avail = fillv - post_used - 1;
        if (avail < 0) avail = 0;
        if (pre_want > avail) pre_want = avail;

        win_start = event - pre_want;
        win_len = pre_want + post_used + 1;
        emit_i = 0;
        pre_actual_set((int)pre_want);
        state = TW_EMIT;
    }
}
